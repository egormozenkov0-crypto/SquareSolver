int SolveSquare(double a, double b, double c, double D,
                double* x1, double* x2, double epsilon) // TODO: double* const
{// TODO: ассертом проверять, что указатели не нулевые. Зачем нужны ассерты

    assert (x1 != NULL);
    assert (x2 != NULL);

    assert (x1 != x2);

    if (fabs(a) < epsilon && fabs(b) < epsilon && fabs(c) < epsilon) // TODO: is_zero(a)
    {
        return 4;
    }
    else if (fabs(a) < epsilon && fabs(b) < epsilon &&  fabs(c) > epsilon)// TODO: if a = 0: solve_linear else и так далее
    {
        return 0;
    }
    else if (fabs(a) < epsilon && fabs(b) > epsilon && fabs(c) < epsilon)
    {
        return 3;
    }
    else if (fabs(a) < epsilon && fabs(b) > epsilon && fabs(c) > epsilon)
    {
        (*x1) = (-c) / b;
        return 1;
    }
    else if (fabs(a) > epsilon)
    {
        if (fabs(b) < epsilon && fabs(c) < epsilon)
        {
            return 3;
        }
        else if (fabs(b) < epsilon && c > -epsilon)
        {
            return 0;
        }
        else
        {
            if (D > epsilon)
            { // TODO: в переменной промежуточные вычисления
                (*x1) = (-b + sqrt(D)) / (2 * a);
                (*x2) = (-b - sqrt(D)) / (2 * a);
                return 2;
            }
            else if (fabs(D) < epsilon)
            {
                (*x1) = (-b) / (2 * a);
                return 1;
            }
            else
            {
                return 0;
            }
        }
    }
    return 0;
}


int vvod (double* const a, double* const b, double* const c)
{

    assert(a != NULL);
    assert(b != NULL);
    assert(c != NULL);

    assert(a != b && a != c && b != c);


    while (scanf("%lg %lg %lg", (*&a), (*&b), (*&c)) != 3)
    {
        int ch = 0;
        while ((ch = getchar()) != '\n' && ch != EOF) {}
        printf("Ошибка ввода! Пожалуйста, введите три числа.\n");
    }
    return 0;
}
