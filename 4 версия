int SolveSquare (double a, double b, double c, double D,
                 double* x1, double* x2, double epsilon);
int vvod (double* a, double* b, double* c);

int main(void)
{
    printf("Мяу\n");
    printf("Эта программа решает квадратные уравнения\n");
    printf("Вы имеете уравнение вида: ax^2+bx+c=0\n");
    printf("Введите пожалуйста коэффициенты\n");


    double a = NAN, b = NAN, c = NAN;       // коэффициенты уравнения
    double x1 = NAN, x2 = NAN;              //корни уравнения
    double epsilon = 1e-12;

    vvod (&a, &b, &c);

    double D = b * b - 4 * a * c;

    int CountRoots = SolveSquare(a, b, c, D, &x1, &x2, epsilon);

    switch (CountRoots)                              // Считает количество корней
    {
        case 0:
            printf ("Корней нет.\n");
            break;
