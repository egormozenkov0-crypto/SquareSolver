#include <TXLib.h>
#include <stdio.h>
#include <math.h>

void SolveSquare(double a, double b, double c, double x1, double x2);

int main(void)
{
    printf("Эта программа решает квадратные уравнения\n"); // TODO: табом отделять
    printf("Вы имеете уравнение вида: ax^2+bx+c=0\n");
    printf("Введите пожалуйста коэффициенты\n");


    double a = 0, b = 0, c = 0;     // коэффициенты уравнения
    double x1 = 0, x2 = 0;          //корни уравнения


    while(scanf("%lg", &a) == 1 && scanf("%lg", &b) == 1 && scanf("%lg", &c) == 1) // TODO: сразу три
    {
        SolveSquare(a, b, c, x1, x2);
    }

    printf("Ты дурак?");                 // Ответ при введении не числовых значений

}

void SolveSquare(double a, double b, double c, double x1, double x2)
{
    if ((b * b - 4 * a * c) < 0)
    {
        printf ("D < 0, уравнение не имеет вещественных корней");
    }
    else if ((b * b - 4 * a * c) == 0)
    {
        x1 = (-b) / (2 * a);
        printf ("Уравнение имеет 1 корень. х = %lg", x1);
    }
    else if ((b * b - 4 * a * c) > 0)
    {
        if (a == 0)
        {
            x1 = (-c) / b;
            printf ("Уравнение имеет один корень. x = %lg", x1);
        }
        else if (a != 0)
        {
            x1 = (-b + sqrt(b * b - 4 * a * c)) / (2 * a);
            x2 = (-b - sqrt(b * b - 4 * a * c)) / (2 * a);
            printf("Корни уравнения: x1 = %lg, x2 = %lg.", x1, x2);
        }
    }
}
